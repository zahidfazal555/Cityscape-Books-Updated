# Copy to .env (never commit .env). Values come from the secret manager in staging/production.
NODE_ENV=development
# App role (RLS applies). Migrations and jobs also need the admin URL.
DATABASE_URL=postgres://csd_app:change-me@localhost:5432/cityscape_books
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/cityscape_books
# base64 of ≥ 32 random bytes: `openssl rand -base64 48`
JWT_SECRET=change-me-base64
APP_URL=http://localhost:3000
# outbox (dev/test only) or smtp. Production must use smtp.
MAIL_MODE=outbox
# smtps://user:pass@host:465 (implicit TLS) or smtp://user:pass@host:587 (STARTTLS required)
SMTP_URL=
MAIL_FROM=Cityscape Books <books@example.com>
# Private, backed-up directory for bill and site photos (required in production).
ATTACHMENT_DIR=/data/attachments
# Reverse proxies in front of the app (for client IPs).
TRUSTED_PROXIES=1
