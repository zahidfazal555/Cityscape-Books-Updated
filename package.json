{
  "name": "cityscape-books",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @csd/core test",
    "test:db": "pnpm --filter @csd/db test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:services": "pnpm --filter @csd/services test",
    "jobs": "tsx packages/services/src/jobs-cli.ts",
    "verify:books": "tsx packages/services/src/jobs-cli.ts verify-books"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
